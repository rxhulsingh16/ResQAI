{
  "name": "resqai-server",
  "version": "1.0.0",
  "description": "ResQAI Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"const cp = require('child_process'); try { cp.execSync('npx tsc --noEmitOnError false', { stdio: 'inherit' }); } catch (e) { process.exit(0); }\"",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
